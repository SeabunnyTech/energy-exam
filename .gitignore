# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Symbolic links to map project (EnergyCityMaps_TRI)
# maps/ links to the entire EnergyCityMaps_TRI repo (includes its own .git, .godot)
/maps
map_control/
facilities/

export/*
*.exe
screenshots/

# Local build output (保留 .gdignore 讓 Godot 不去 import 匯出檔)
bin/*
!bin/.gdignore

# 素材/文件暫存區、錄影檔
tmp/
*.avi